# ── Secrets / environment ──────────────────────────────────────────────────
# NEVER commit real secrets. .env.example IS committed as the template.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.Python

# ── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv (uv.lock IS committed — it pins the dependency graph) ────────────────
.uv/

# ── Testing / coverage ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# ── Linters / type checkers ────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json

# ── Logs / runtime artifacts ───────────────────────────────────────────────
*.log
logs/
runner.log

# ── ML / training artifacts (weights live on the Modal Volume, not in git) ──
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
lora_*/
artifacts/
wandb/
.cache/huggingface/
*.jsonl.tmp
train_*.jsonl

# ── Local data / DB dumps ──────────────────────────────────────────────────
*.sqlite3
*.db
*.dump

# ── IDE / OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
