# ============================================================
# Continuous Fine-Tuning Pipeline — Environment Variables
# Copy this file to .env and fill in all values before starting
# ============================================================

# --- Environment ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-random-hex-32-chars

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://pipeline:password@localhost:5432/finetuning_pipeline
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
POSTGRES_PASSWORD=password

# --- Redis 7 ---
REDIS_URL=redis://:password@localhost:6379/0
REDIS_PASSWORD=password
REDIS_MAX_CONNECTIONS=50

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=finetuning-pipeline
KAFKA_TOPIC_LLM_EVENTS=llm.production.events
KAFKA_TOPIC_TRAINING_EVENTS=pipeline.training.events
KAFKA_TOPIC_DLQ=pipeline.dlq

# --- LLM APIs ---
OPENAI_API_KEY=sk-...
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=continuous-finetuning
BASE_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
TEACHER_MODEL=gpt-4o

# --- Training Trigger ---
TRAINING_TRIGGER_DATASET_SIZE=500
TRAINING_TRIGGER_DRIFT_THRESHOLD=0.15
TRAINING_MIN_INTERVAL_HOURS=6

# --- LoRA Hyperparameters ---
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=["q_proj","v_proj"]
LORA_TRAINING_EPOCHS=3
LORA_LEARNING_RATE=0.0002
LORA_BATCH_SIZE=4
LORA_GRADIENT_ACCUMULATION=4

# --- Evaluation Gates ---
EVAL_SET_SIZE=200
EVAL_IMPROVEMENT_THRESHOLD=0.03
EVAL_SAFETY_BATTERY_SIZE=100
MIN_EVAL_EXAMPLES=50           # Floor before a promotion decision is trusted; seed via scripts/seed_eval_set.py
AB_SHADOW_TRAFFIC_PCT=0.10
AB_MIN_REQUESTS=1000
AB_MIN_HOURS=48.0
AB_PVALUE_THRESHOLD=0.05
AB_COHENS_D_THRESHOLD=0.10
# Shadow quality scoring (replaces the old circular self-comparison metric)
SHADOW_SCORING_STRATEGY=llm_judge       # llm_judge | reference_rouge
SHADOW_REFERENCE_SIM_THRESHOLD=0.85
SHADOW_JUDGE_MODEL=gpt-4o-mini

# --- Detection Thresholds ---
HALLUCINATION_THRESHOLD=0.50   # NLI: flag if mean non-entailment exceeds this (was CLAP_HALLUCINATION_THRESHOLD)
DRIFT_MAHALANOBIS_THRESHOLD=0.15
DRIFT_BASELINE_MIN_SAMPLES=500
REFUSAL_RATE_MULTIPLIER=2.0
FORMAT_KL_THRESHOLD=0.5

# --- Curation ---
TEACHER_CONFIDENCE_THRESHOLD=0.85
TEACHER_CONSISTENCY_TEMPERATURE=0.7   # >0 so self-consistency votes actually differ
MAX_CONCURRENT_TEACHER_CALLS=20       # Caps simultaneous GPT-4o calls per curation batch
CURATION_COST_BUDGET_USD=25.0         # Per-run teacher spend circuit breaker
DEDUP_JACCARD_THRESHOLD=0.85
QUALITY_ROUGE_THRESHOLD=0.30
PII_FAIL_CLOSED=true

# --- Safety Classifier ---
SAFETY_CLASSIFIER=llama_guard         # llama_guard | keyword_fallback
TOGETHER_API_KEY=                     # Required for Llama Guard 3; falls back to keyword matching (logged) if unset
LLAMA_GUARD_MODEL=meta-llama/Meta-Llama-Guard-3-8B

# --- Threshold Calibration ---
ALLOW_AUTO_CALIBRATION=false     # suggest-only unless true
CALIBRATION_FP_TARGET=0.30
CALIBRATION_STEP=0.05
CALIBRATION_INTERVAL_CYCLES=100
CALIBRATION_MIN_SAMPLES=20

# --- Canary (live partial rollout before full promotion) ---
# Off by default: requires the serving layer to call CanaryController.record_result.
CANARY_ENABLED=false
CANARY_TRAFFIC_PCT=0.05
CANARY_WINDOW_MINUTES=60
CANARY_MIN_REQUESTS=50
CANARY_MAX_ERROR_RATE=0.01

# --- Cost Controls ---
MONTHLY_BUDGET_USD=500.0
SINGLE_RUN_BUDGET_USD=50.0
MODAL_A100_HOURLY_USD=4.0        # Estimated A100 rate for GPU cost tracking

# --- Audit / Vault ---
VAULT_URL=http://localhost:8200
VAULT_TOKEN=root
HMAC_KEY_PATH=secret/pipeline/hmac_key
# VAULT_REQUIRED: true in production — the pipeline refuses to sign audit entries
# with the local fallback key if Vault is unreachable. Set false only for dev.
VAULT_REQUIRED=true

# --- Monitoring ---
LOG_LEVEL=INFO
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
WANDB_API_KEY=
WANDB_PROJECT=continuous-finetuning

# --- Modal Labs (GPU) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Grafana ---
GRAFANA_PASSWORD=admin
